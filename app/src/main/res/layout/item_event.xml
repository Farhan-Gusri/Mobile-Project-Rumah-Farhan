<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/ivEvent"
            android:layout_width="100dp"
            android:layout_height="110dp"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_lays"
            android:contentDescription="Gambar event"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/tvNamaEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Turnamen Futsal"
                android:textColor="#174A91"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTanggalEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="12 Juni 2026"
                android:textColor="#666666"
                android:textSize="13sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvLokasiEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pekanbaru"
                android:textColor="#666666"
                android:textSize="13sp"
                android:layout_marginTop="5dp"/>

            <TextView
                android:id="@+id/tvStatusEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aktif"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:layout_marginTop="8dp"
                android:background="#4CAF50"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
