<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F4F8FF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daftar Event"
        android:textColor="#174A91"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"/>

    <EditText
        android:id="@+id/etCariEvent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Cari event..."
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_card_blue"
        android:singleLine="true"
        android:inputType="text"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kegiatan Garuda Melayu"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnKelolaEvent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kelola Data Event"
        android:layout_marginBottom="12dp" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEvent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"/>

</LinearLayout>
