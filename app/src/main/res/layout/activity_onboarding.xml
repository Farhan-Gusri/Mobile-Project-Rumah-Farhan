<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F4F8FF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GARUDA MELAYU"
        android:textColor="#174A91"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="35dp"/>

    <TextView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:gravity="center"
        android:text="GM"
        android:textColor="#FFFFFF"
        android:textSize="55sp"
        android:textStyle="bold"
        android:background="@drawable/bg_card_blue"/>

    <TextView
        android:id="@+id/tvOnboardingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Selamat Datang"
        android:textColor="#174A91"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"/>

    <TextView
        android:id="@+id/tvOnboardingDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#555555"
        android:textSize="16sp"
        android:lineSpacingExtra="6dp"
        android:layout_marginTop="15dp"/>

    <TextView
        android:id="@+id/tvIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 / 3"
        android:textColor="#174A91"
        android:textStyle="bold"
        android:layout_marginTop="30dp"/>

    <Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Selanjutnya"
        android:textColor="#173D70"
        android:background="@drawable/bg_button_primary"
        android:layout_marginTop="25dp"/>

    <Button
        android:id="@+id/btnSkip"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Lewati"
        android:textColor="#174A91"
        android:backgroundTint="#F4F8FF"
        android:layout_marginTop="8dp"/>

</LinearLayout>
